---
import { Image } from 'astro:assets';
import owlImg from '../assets/owl.png';

const title = "nightowl.engineer";
const url = "https://nightowl.engineer";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={title} />
    <meta name="theme-color" content="#0d1117" />
    <title>{title}</title>

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="canonical" href={url} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={title} />

    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      :root {
        --bg: #0d1117;
        --text: #e6edf3;
        --muted: #8b949e;
        --accent: #58a6ff;
      }

      html, body {
        height: 100%;
      }

      body {
        background: var(--bg);
        color: var(--text);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        padding: 2rem;
      }

      main {
        text-align: center;
        max-width: 42rem;
        position: relative;
        z-index: 1;
      }

      .wordmark {
        font-size: clamp(2rem, 6vw, 3.5rem);
        font-weight: 700;
        letter-spacing: -0.02em;
        line-height: 1.1;
        color: var(--text);
      }

      .wordmark span {
        color: var(--accent);
      }

      .bg-owl {
        position: fixed;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        pointer-events: none;
        z-index: 0;
      }

      .bg-owl img {
        height: 80vh;
        width: auto;
        opacity: 0.2;
        user-select: none;
      }

      @media (prefers-reduced-motion: reduce) {
        .bg-owl img {
          animation: none;
        }
      }
    </style>
  </head>
  <body>
    <div class="bg-owl" aria-hidden="true">
      <Image src={owlImg} alt="" width={800} loading="eager" />
    </div>
    <main>
      <h1 class="wordmark">nightowl.<span>engineer</span></h1>
    </main>
  </body>
</html>
